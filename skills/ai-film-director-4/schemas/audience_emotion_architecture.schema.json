{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audience Emotion Architecture",
  "type": "object",
  "required": ["project_title", "project_type", "axis", "summary", "phases", "nodes", "fatigue_zones", "paragraphs", "actor_emotion_tracks"],
  "properties": {
    "project_title": {"type": "string", "minLength": 1},
    "project_type": {"enum": ["film", "series"]},
    "axis": {
      "type": "object",
      "required": ["type", "max", "unit_label"],
      "properties": {
        "type": {"enum": ["minute", "episode"]},
        "max": {"type": "number", "exclusiveMinimum": 0},
        "unit_label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "summary": {"type": "object"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase_id", "range_label", "start", "end", "name", "primary_emotion", "entry_intensity", "peak_intensity", "exit_intensity"],
        "properties": {
          "phase_id": {"type": "string"},
          "range_label": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "name": {"type": "string"},
          "primary_emotion": {"type": "string"},
          "entry_intensity": {"type": "number", "minimum": 0, "maximum": 10},
          "peak_intensity": {"type": "number", "minimum": 0, "maximum": 10},
          "exit_intensity": {"type": "number", "minimum": 0, "maximum": 10}
        },
        "additionalProperties": true
      }
    },
    "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "position", "label", "intensity"], "additionalProperties": true}},
    "fatigue_zones": {"type": "array", "items": {"type": "object", "required": ["start", "end", "label"], "additionalProperties": true}},
    "paragraphs": {"type": "array", "items": {"type": "object", "required": ["title", "text"], "additionalProperties": true}},
    "actor_emotion_tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["character_id", "character_name", "points"],
        "properties": {
          "character_id": {"type": "string", "minLength": 1},
          "character_name": {"type": "string", "minLength": 1},
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["position", "intensity", "internal_emotion", "performed_emotion", "strategy", "event_basis"],
              "properties": {
                "position": {"type": "number", "minimum": 0},
                "intensity": {"type": "number", "minimum": 0, "maximum": 10},
                "internal_emotion": {"type": "string", "minLength": 1},
                "performed_emotion": {"type": "string", "minLength": 1},
                "strategy": {"type": "string", "minLength": 1},
                "event_basis": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "episode_details": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
