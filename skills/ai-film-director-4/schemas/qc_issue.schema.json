{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QC Issue Routing",
  "type": "object",
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "error_code",
          "owner_layer",
          "affected_ids",
          "reason",
          "rerun_path",
          "do_not_rerun"
        ],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^QC\\d+$"},
          "severity": {"enum": ["HARD", "WARNING"]},
          "error_code": {"type": "string", "minLength": 1},
          "owner_layer": {
            "enum": [
              "STORY", "AUTHORITY", "EMOTION", "SCENE_INTELLIGENCE", "ROUTER",
              "DIRECTOR", "ASSET", "SPATIAL", "SHOT_SEGMENT", "DELIVERY"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "reason": {"type": "string", "minLength": 1},
          "rerun_path": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "do_not_rerun": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
