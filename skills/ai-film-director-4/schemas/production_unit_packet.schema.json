{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"AFD Production Unit Packet V1","type":"object",
  "required":["packet_contract","unit_id","scene_scope","scope_manifest_sha256","expected_story_atom_ids","information_ids","project_refs","inherited_state","generation_profile"],
  "properties":{
    "packet_contract":{"const":"AFD_PRODUCTION_UNIT_PACKET_V1"},"unit_id":{"type":"string","pattern":"^PU[0-9]{3}$"},
    "scene_scope":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^SC[0-9]{3}$"},"uniqueItems":true},
    "scope_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"expected_story_atom_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "information_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"project_refs":{"type":"object"},
    "inherited_state":{"type":["object","null"]},"generation_profile":{"type":"object"}
  },"additionalProperties":false
}
