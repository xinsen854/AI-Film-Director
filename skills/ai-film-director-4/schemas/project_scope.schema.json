{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AFD Project Scope V1",
  "type":"object",
  "required":["scope_contract","project_id","work_format","locked_screenplay_path","locked_screenplay_sha256","project_brief_sha256","target_runtime_seconds","scene_count","scene_ids","production_units","scope_manifest_sha256"],
  "properties":{
    "scope_contract":{"const":"AFD_PROJECT_SCOPE_V1"},"project_id":{"type":"string"},"work_format":{"const":"film"},
    "locked_screenplay_path":{"type":"string"},"locked_screenplay_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "project_brief_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"target_runtime_seconds":{"type":"number","exclusiveMinimum":0},
    "scene_count":{"type":"integer","minimum":1},"scene_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^SC[0-9]{3}$"},"uniqueItems":true},
    "production_units":{"type":"array","minItems":1,"items":{"type":"object","required":["unit_id","scene_ids"],"properties":{"unit_id":{"type":"string","pattern":"^PU[0-9]{3}$"},"scene_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^SC[0-9]{3}$"},"uniqueItems":true}},"additionalProperties":false}},
    "scope_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },"additionalProperties":false
}
