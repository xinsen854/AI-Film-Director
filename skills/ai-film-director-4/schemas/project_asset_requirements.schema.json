{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AFD Project Asset Requirements V1",
  "type":"object",
  "required":["requirements_contract","scope_manifest_sha256","locked_screenplay_sha256","requirements","scene_inventory","requirements_manifest_sha256"],
  "properties":{
    "requirements_contract":{"const":"AFD_PROJECT_ASSET_REQUIREMENTS_V1"},
    "scope_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "locked_screenplay_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "requirements":{"type":"array","items":{"type":"object","required":["requirement_id","kind","canonical_name","scene_ids","source_evidence"],"properties":{
      "requirement_id":{"type":"string","pattern":"^AR[0-9]{3,}$"},
      "kind":{"enum":["character_base","character_state","location","prop","entity","voice"]},
      "canonical_name":{"type":"string","minLength":1},"state_label":{"type":"string"},"parent_requirement_id":{"type":"string"},
      "scene_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^SC[0-9]{3}$"},"uniqueItems":true},
      "source_evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
    },"additionalProperties":false}},
    "scene_inventory":{"type":"array","minItems":1,"items":{"type":"object","required":["scene_id","requirement_ids"],"properties":{"scene_id":{"type":"string","pattern":"^SC[0-9]{3}$"},"requirement_ids":{"type":"array","items":{"type":"string","pattern":"^AR[0-9]{3,}$"},"uniqueItems":true}},"additionalProperties":false}},
    "requirements_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },"additionalProperties":false
}
